{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World Intelligence intent proposal",
  "type": "object",
  "required": ["action_id", "intent", "motivation", "expected_outcome", "confidence", "world_revision", "npc_state_version"],
  "properties": {
    "action_id": {"type": "string"},
    "intent": {"type": "string"},
    "motivation": {"type": "string"},
    "expected_outcome": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "world_revision": {"type": "integer", "minimum": 0},
    "npc_state_version": {"type": "integer", "minimum": 0},
    "dialogue": {"type": "string"}
  },
  "additionalProperties": false
}
