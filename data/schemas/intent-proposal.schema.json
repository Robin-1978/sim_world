{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World Intelligence intent proposal",
  "type": "object",
  "description": "The structured payload returned by the decision provider. Runtime adds world and NPC versions from the captured context before validation and commit.",
  "required": ["action_id", "intent", "motivation", "expected_outcome", "confidence", "dialogue", "cited_stimulus_ids", "tradeoffs", "expected_relief", "parameters"],
  "properties": {
    "action_id": {"type": "string"},
    "intent": {"type": "string"},
    "motivation": {"type": "string"},
    "expected_outcome": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "cited_stimulus_ids": {"type": "array", "items": {"type": "string"}},
    "tradeoffs": {"type": "array", "items": {"type": "string"}},
    "expected_relief": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "parameters": {"type": "object"},
    "dialogue": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
