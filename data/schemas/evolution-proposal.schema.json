{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive World Evolution Proposal",
  "type": "object",
  "required": ["kind", "schema_version", "id", "source", "base_content_version", "base_world_revision", "evidence_event_sequences", "operations", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["content", "knowledge", "strategy", "declarative_capability", "innovation"]},
    "source": {"type": "string", "minLength": 1},
    "base_content_version": {"type": "string", "minLength": 1},
    "base_world_revision": {"type": "integer", "minimum": 0},
    "evidence_event_sequences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "id"],
        "properties": {
          "operation": {"type": "string", "enum": ["create_entity_archetype", "register_behavior_recipe", "overlay_strategy", "overlay_schedule"]},
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "available_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "plan_id": {"type": "string", "minLength": 1},
          "duration_minutes": {"type": "integer", "minimum": 0},
          "interruptible": {"type": "boolean"},
          "interrupt_salience_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "reservation_mode": {"enum": ["none", "input_resources"]},
          "priority": {"type": "integer", "minimum": 0},
          "preemption_policy": {"enum": ["none", "lower_priority"]},
          "parameters": {"type": "object"},
          "root": {"$ref": "#/$defs/behavior_node"},
          "npc_id": {"type": "string", "minLength": 1},
          "peer_id": {"type": "string", "minLength": 1},
          "min_peer_trust": {"type": "number", "minimum": 0, "maximum": 1},
          "strategy": {"type": "string", "minLength": 1},
          "goal_stage": {"type": "integer", "minimum": 0},
          "memory": {"type": "string"},
          "event_type": {"type": "string", "minLength": 1},
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["start_minute", "end_minute", "location"],
              "properties": {
                "start_minute": {"type": "integer", "minimum": 0, "maximum": 1439},
                "end_minute": {"type": "integer", "minimum": 0, "maximum": 1439},
                "location": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "meta_actions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"operation": {"const": "create_entity_archetype"}}},
           "then": {"required": ["kind"]}},
          {"if": {"properties": {"operation": {"const": "register_behavior_recipe"}}},
           "then": {"required": ["plan_id", "duration_minutes", "interruptible", "interrupt_salience_threshold", "reservation_mode", "priority", "preemption_policy", "parameters", "available_to", "root"]}},
          {"if": {"properties": {"operation": {"const": "overlay_strategy"}}},
           "then": {"required": ["npc_id", "peer_id", "min_peer_trust", "strategy", "goal_stage", "memory", "event_type"]}},
          {"if": {"properties": {"operation": {"const": "overlay_schedule"}}},
           "then": {"required": ["npc_id", "slots"]}}
        ]
      }
    },
    "status": {"type": "string", "enum": ["proposed", "validated", "approved", "rejected"]},
    "target_npc": {"type": "string", "minLength": 1},
    "evolution_level": {"type": "string", "enum": ["level1", "level2"]},
    "innovation_status": {"enum": ["hypothesized", "refining", "evaluated", "accepted", "rejected", "abandoned"]},
    "innovation": {
      "type": "object",
      "required": ["hypothesis", "novelty_basis", "operation_ids", "expected_benefits", "risks", "test_plan"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1024},
        "novelty_basis": {"enum": ["new_combination", "new_capability", "new_archetype"]},
        "operation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_benefits": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "risks": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "test_plan": {
          "type": "object",
          "required": ["horizon_minutes", "metrics", "baseline", "scenario", "expected_metrics", "constraints", "resource_budget", "success_criteria", "failure_criteria"],
          "properties": {
            "horizon_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
            "metrics": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
              "items": {"enum": ["events_added", "final_revision", "npc_count", "knowledge_count", "experience_count", "advance_minutes", "resource_total"]}},
            "baseline": {"type": "string", "minLength": 1, "maxLength": 512},
            "scenario": {"type": "string", "minLength": 1, "maxLength": 512},
            "expected_metrics": {"type": "object", "minProperties": 1, "maxProperties": 6, "additionalProperties": {"type": "number"}},
            "constraints": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
            "resource_budget": {"type": "object", "minProperties": 1, "maxProperties": 8, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1000000}},
            "success_criteria": {"type": "string", "minLength": 1, "maxLength": 512},
            "failure_criteria": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"required": ["evolution_level"], "properties": {"evolution_level": {"const": "level1"}}},
     "then": {"required": ["target_npc"]}},
    {"if": {"required": ["evolution_level"], "properties": {"evolution_level": {"const": "level2"}}},
     "then": {"not": {"required": ["target_npc"]}}},
    {"if": {"properties": {"kind": {"const": "innovation"}}},
     "then": {"required": ["innovation"], "properties": {"innovation_status": {"enum": ["hypothesized", "refining", "evaluated", "accepted", "rejected", "abandoned"]}}}},
    {"if": {"properties": {"kind": {"const": "innovation"}, "evolution_level": {"const": "level1"}}},
     "then": {"properties": {"innovation": {"properties": {"novelty_basis": {"enum": ["new_combination", "new_capability"]}}}}}}
  ],
  "additionalProperties": false,
  "$defs": {
    "behavior_node": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["sequence", "selector", "condition", "meta_action", "interruptible", "timeout"]},
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "args": {"type": "object"},
        "max_ticks": {"type": "integer", "minimum": 0},
        "children": {"type": "array", "items": {"$ref": "#/$defs/behavior_node"}}
      },
      "additionalProperties": false
    }
  }
}
