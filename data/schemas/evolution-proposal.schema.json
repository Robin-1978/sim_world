{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive World Evolution Proposal",
  "type": "object",
  "required": ["kind", "schema_version", "id", "source", "base_content_version", "base_world_revision", "evidence_event_sequences", "operations", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["content", "knowledge", "strategy", "declarative_capability"]},
    "source": {"type": "string", "minLength": 1},
    "base_content_version": {"type": "string", "minLength": 1},
    "base_world_revision": {"type": "integer", "minimum": 0},
    "evidence_event_sequences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "id"],
        "properties": {
          "operation": {"type": "string", "enum": ["create_entity_archetype", "register_behavior_recipe", "overlay_strategy"]},
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "available_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "plan_id": {"type": "string", "minLength": 1},
          "duration_minutes": {"type": "integer", "minimum": 0},
          "interruptible": {"type": "boolean"},
          "interrupt_salience_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "reservation_mode": {"enum": ["none", "input_resources"]},
          "priority": {"type": "integer", "minimum": 0},
          "preemption_policy": {"enum": ["none", "lower_priority"]},
          "parameters": {"type": "object"},
          "meta_actions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "status": {"type": "string", "enum": ["proposed", "validated", "approved", "rejected"]}
    ,"evolution_level": {"type": "string", "enum": ["level1", "level2"]}
  },
  "additionalProperties": false
}
