{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive World Daily Reflection Result",
  "type": "object",
  "required": ["schema_version", "npc_id", "evidence_event_sequences", "cognition_updates", "strategy_adjustment", "goal_adjustment", "unresolved_issues", "resolved_issues", "innovation_hypotheses", "innovation_actions", "rationale"],
  "properties": {
    "schema_version": {"const": 1},
    "npc_id": {"type": "string", "minLength": 1},
    "evidence_event_sequences": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "cognition_updates": {
      "type": "object",
      "required": ["belief_updates", "experience_updates", "memory_updates"],
      "properties": {
        "belief_updates": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/belief_update"}},
        "experience_updates": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/experience_update"}},
        "memory_updates": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/memory_update"}}
      },
      "additionalProperties": false
    },
    "strategy_adjustment": {"type": "object", "properties": {"strategy": {"type": "string", "maxLength": 128}}, "additionalProperties": false},
    "goal_adjustment": {"type": "object", "properties": {"priority_delta": {"type": "number", "minimum": -1, "maximum": 1}, "status": {"const": "cancelled"}}, "additionalProperties": false},
    "unresolved_issues": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "resolved_issues": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "innovation_hypotheses": {"type": "array", "maxItems": 2, "items": {"$ref": "evolution-proposal.schema.json"}},
    "innovation_actions": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["proposal_id", "status"], "properties": {"proposal_id": {"type": "string", "minLength": 1}, "status": {"enum": ["refining", "evaluated", "accepted", "rejected", "abandoned"]}}, "additionalProperties": false}},
    "rationale": {"type": "string", "maxLength": 1024}
  },
  "additionalProperties": false,
  "$defs": {
    "belief_update": {
      "type": "object",
      "required": ["subject", "predicate", "value", "source_sequence", "confidence"],
      "properties": {
        "subject": {"type": "string", "minLength": 1, "maxLength": 128},
        "predicate": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_sequence": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["direct", "witness", "testimony", "inference"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "experience_update": {
      "type": "object",
      "required": ["domain", "trigger", "action", "outcome", "source_sequence", "confidence"],
      "properties": {
        "domain": {"type": "string", "minLength": 1, "maxLength": 128},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 256},
        "action": {"type": "string", "minLength": 1, "maxLength": 128},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_sequence": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "personal": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "memory_update": {
      "type": "object",
      "required": ["text", "source_sequence"],
      "properties": {
        "kind": {"type": "string", "maxLength": 64},
        "text": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_sequence": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
