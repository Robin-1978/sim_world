{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive world NPC content",
  "type": "object",
  "required": [
    "id",
    "name",
    "role",
    "home",
    "workplace",
    "public_goal",
    "hidden_goal",
    "boundary",
    "needs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "maxLength": 512
    },
    "home": {
      "type": "string",
      "maxLength": 256
    },
    "workplace": {
      "type": "string",
      "maxLength": 256
    },
    "public_goal": {
      "type": "string",
      "maxLength": 2048
    },
    "hidden_goal": {
      "type": "string",
      "maxLength": 2048
    },
    "boundary": {
      "type": "string",
      "maxLength": 2048
    },
    "voice": {
      "type": "string",
      "maxLength": 1024
    },
    "private_traits": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "initial": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string"
        },
        "schedule_label": {
          "type": "string"
        },
        "goal_stage": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "string"
        },
        "peer_trust": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "initial_deficit",
          "decay_per_hour",
          "critical_threshold",
          "weight",
          "priority",
          "satisfiers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string"
          },
          "initial_deficit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decay_per_hour": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "critical_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "source_kind": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "satisfiers": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "relief",
                "meta_actions"
              ],
              "properties": {
                "relief": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "meta_actions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "simulation_tier": {
      "enum": [
        "near",
        "far"
      ]
    }
  },
  "additionalProperties": false
}
