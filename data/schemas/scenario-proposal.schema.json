{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive World Scenario Proposal",
  "type": "object",
  "required": ["kind", "schema_version", "id", "source", "base_content_version", "base_world_revision", "duration_minutes", "interventions"],
  "properties": {
    "kind": {"const": "scenario_proposal"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "base_content_version": {"type": "string", "minLength": 1},
    "base_world_revision": {"type": "integer", "minimum": 0},
    "duration_minutes": {"type": "integer", "minimum": 0, "maximum": 527040},
    "interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "subject", "delta"],
        "properties": {
          "operation": {"enum": ["resource.delta", "group_metric.delta", "npc.need.delta"]},
          "subject": {"type": "string", "minLength": 1},
          "metric": {"type": "string"},
          "delta": {"type": "number"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
