    {
      "id": "visitor_dialogue",
      "conversation": true,
      "classify_speech_act": true,
      "default_world_action_allowed": false,
      "default_speech_act": "statement",
      "event_type": "dialogue.turn",
      "memory_kind": "conversation",
      "event_target": "player",
