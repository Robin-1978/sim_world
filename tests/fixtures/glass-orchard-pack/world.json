    },
    {
      "id": "warden_reflection",
      "conversation": false,
      "classify_speech_act": false,
      "default_world_action_allowed": true,
      "default_speech_act": "autonomous",
      "event_type": "world.intent",
      "memory_kind": "intent",
      "event_target": "self",
      "provider_policy": "autonomous_reappraisal"
    }
  ],
  "anomaly_rules": [
    {
      "id": "compact_accord_low",
      "operation": "group_metric.below",
