    "speech_acts": [
      {"id": "greeting", "world_action_allowed": false, "patterns": ["hello", "hi ", "你好", "您好"]},
      {"id": "farewell", "world_action_allowed": false, "patterns": ["bye", "goodbye", "再见"]},
      {"id": "request", "world_action_allowed": true, "patterns": ["please", "can you", "请", "帮我"]},
      {"id": "inquiry", "world_action_allowed": false, "patterns": ["what ", "why ", "什么", "为什么", "?"]}
