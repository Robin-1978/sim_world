{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default local build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TIDE_MARKS_WARNINGS": "ON"
      }
    },
    {
      "name": "engine",
      "displayName": "raylib and Bullet client",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "TIDE_MARKS_FETCH_RAYLIB": "ON",
        "TIDE_MARKS_FETCH_BULLET": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "engine", "configurePreset": "engine" }
  ]
}
